[Unit]
Description=BRIC Light Wall tile discovery responder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/bric-lightwall/tile.env
WorkingDirectory=/opt/bric-lightwall/bric-tile-receiver
ExecStart=/usr/bin/python3 /opt/bric-lightwall/bric-tile-receiver/tools/discovery_responder.py --config /etc/bric-lightwall/tile.env
Restart=always
RestartSec=2
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

